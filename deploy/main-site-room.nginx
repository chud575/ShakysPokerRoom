# Add to the shakybetspokertools.com server block on the MAIN droplet
# (/etc/nginx/sites-available/shakybets — certbot manages that file, so edit it there,
#  next to the other tool locations; the server-wide auth_request gate applies, and the
#  accounts service only lets through users holding the "Poker Room" tool):
    location = /room {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
