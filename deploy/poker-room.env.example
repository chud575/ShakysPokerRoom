# /etc/poker-room.env  (root:pokerroom, mode 640) — restart after editing:  systemctl restart poker-room
DB=/var/lib/poker-room/room.db
HOST=127.0.0.1
PORT=8790

# ShakyBets sign-in.  The SAME secret goes in the accounts service's ROOM_HANDOFF_SECRET
# (/etc/shakybets-auth.env on the main droplet).  Generate with:  openssl rand -hex 32
ROOM_HANDOFF_SECRET=
ROOM_LOGIN_URL=https://shakybetspokertools.com/room
# only pages from this address may open the game socket
ROOM_ORIGINS=https://room.shakybetspokertools.com
